# For deploy/Caddyfile: backend and Caddy run on the same host.
# Export these variables, or use a service manager's EnvironmentFile.
# The binary does not automatically read this file.
PUZZELLA_RENDEZVOUS_LISTEN=127.0.0.1:8080
PUZZELLA_RENDEZVOUS_TRUSTED_PROXIES=127.0.0.1/32
PUZZELLA_RENDEZVOUS_MAX_CONNECTIONS=1024
PUZZELLA_RENDEZVOUS_MAX_CONNECTIONS_PER_IP=64
PUZZELLA_RENDEZVOUS_MAX_ADMISSIONS_PER_IP_PER_MINUTE=60
PUZZELLA_RENDEZVOUS_MAX_ROOM_ATTEMPTS_PER_IP_PER_MINUTE=120
PUZZELLA_RENDEZVOUS_MAX_OUTBOUND_MESSAGES=128
PUZZELLA_RENDEZVOUS_MAX_OUTBOUND_BYTES_PER_CONNECTION=262144
PUZZELLA_RENDEZVOUS_MAX_OUTBOUND_BYTES_GLOBAL=33554432

# Optional Cloudflare Realtime TURN (server secrets; never ship in client config).
# Set both values or leave both absent. Obtain a TURN key and its API token in Cloudflare.
# PUZZELLA_RENDEZVOUS_TURN_KEY_ID=your-turn-key-id
# PUZZELLA_RENDEZVOUS_TURN_API_TOKEN=your-server-only-api-token
PUZZELLA_RENDEZVOUS_TURN_TTL_SECONDS=86400
PUZZELLA_RENDEZVOUS_TURN_MAX_CONCURRENCY=4
PUZZELLA_RENDEZVOUS_TURN_REQUESTS_PER_MINUTE=120

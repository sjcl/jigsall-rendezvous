# For deploy/Caddyfile: backend and Caddy run on the same host.
# Export these variables, or use a service manager's EnvironmentFile.
# The binary does not automatically read this file.
PUZZELLA_RENDEZVOUS_LISTEN=127.0.0.1:8080
PUZZELLA_RENDEZVOUS_TRUSTED_PROXIES=127.0.0.1/32
PUZZELLA_RENDEZVOUS_MAX_CONNECTIONS=1024
PUZZELLA_RENDEZVOUS_MAX_CONNECTIONS_PER_IP=64
PUZZELLA_RENDEZVOUS_MAX_ADMISSIONS_PER_IP_PER_MINUTE=60
PUZZELLA_RENDEZVOUS_MAX_ROOM_ATTEMPTS_PER_IP_PER_MINUTE=120
PUZZELLA_RENDEZVOUS_MAX_OUTBOUND_MESSAGES=128
PUZZELLA_RENDEZVOUS_MAX_OUTBOUND_BYTES_PER_CONNECTION=262144
PUZZELLA_RENDEZVOUS_MAX_OUTBOUND_BYTES_GLOBAL=33554432

# Optional Cloudflare Realtime TURN (server secrets; never ship in client config).
# Set both values or leave both absent. Obtain a TURN key and its API token in Cloudflare.
# PUZZELLA_RENDEZVOUS_TURN_KEY_ID=your-turn-key-id
# PUZZELLA_RENDEZVOUS_TURN_API_TOKEN=your-server-only-api-token
PUZZELLA_RENDEZVOUS_TURN_TTL_SECONDS=86400
PUZZELLA_RENDEZVOUS_TURN_MAX_CONCURRENCY=4
PUZZELLA_RENDEZVOUS_TURN_REQUESTS_PER_MINUTE=120

# Optional usage guard. Enable only after configuring every required value below.
# Analytics token: Account / Account Analytics / Read on the selected account.
# Separate from the TURN key's issuance/revoke API token.
PUZZELLA_RENDEZVOUS_TURN_BUDGET_ENABLED=false
# PUZZELLA_RENDEZVOUS_TURN_BUDGET_ACCOUNT_ID=your-32-hex-account-id
# PUZZELLA_RENDEZVOUS_TURN_BUDGET_ANALYTICS_TOKEN=your-analytics-read-token
# Example thresholds in bytes; choose headroom for sampling/poll/revoke delay.
# PUZZELLA_RENDEZVOUS_TURN_BUDGET_SOFT_LIMIT_BYTES=800000000000
# PUZZELLA_RENDEZVOUS_TURN_BUDGET_HARD_LIMIT_BYTES=900000000000
# Use your account's actual billing day/time, not necessarily the first.
# PUZZELLA_RENDEZVOUS_TURN_BUDGET_BILLING_ANCHOR=2026-01-17T12:00:00Z
# Unset = calendar months. Only set for an actual fixed-length billing cycle.
# PUZZELLA_RENDEZVOUS_TURN_BUDGET_PERIOD_SECONDS=2592000
# Persistent directory must already exist and be writable by the server UID.
# PUZZELLA_RENDEZVOUS_TURN_BUDGET_REGISTRY_PATH=/var/lib/puzzella-turn/registry.jsonl
# PUZZELLA_RENDEZVOUS_TURN_BUDGET_POLL_SECONDS=30
# PUZZELLA_RENDEZVOUS_TURN_BUDGET_STALE_SECONDS=300
